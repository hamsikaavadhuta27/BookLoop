# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Port the website will run on: http://localhost:3000
PORT=3000

# Local MongoDB (install MongoDB Community Server, or use MongoDB Atlas)
# Local example:
MONGODB_URI=mongodb://127.0.0.1:27017/bookloop

# Atlas example (replace with your own connection string):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/bookloop
